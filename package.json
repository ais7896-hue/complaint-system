{
  "name": "complaint-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./public --d1=DB=complaint-db",
    "deploy": "wrangler pages deploy ./public",
    "db:init:local": "wrangler d1 execute complaint-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute complaint-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
